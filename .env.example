# Local speech-to-text through Ollama (no transcription API key or usage fee)
TRANSCRIPTION_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=frozenlab/qwen3-asr:1.7b
OLLAMA_TIMEOUT_SECONDS=180

# Optional transcript analysis only. This is separate from transcription.
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
APP_URL=http://localhost:8501

# Upload limits
MAX_UPLOAD_MB=50
